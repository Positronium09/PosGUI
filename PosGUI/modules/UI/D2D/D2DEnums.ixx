		HighQualityCubic = D2D1_INTERPOLATION_MODE_DEFINITION_HIGH_QUALITY_CUBIC
	};

	enum class InterpolationMode
	{
		NearestNeighbor = D2D1_INTERPOLATION_MODE_NEAREST_NEIGHBOR,
		Linear = D2D1_INTERPOLATION_MODE_LINEAR,
