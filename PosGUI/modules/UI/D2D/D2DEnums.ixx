		Unknown = D2D1_GEOMETRY_RELATION_UNKNOWN,
		Disjoint = D2D1_GEOMETRY_RELATION_DISJOINT,
		IsContained = D2D1_GEOMETRY_RELATION_IS_CONTAINED,
